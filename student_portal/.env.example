DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP, set DJANGO_EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and configure DJANGO_EMAIL_HOST, DJANGO_EMAIL_PORT, DJANGO_EMAIL_HOST_USER,
# DJANGO_EMAIL_HOST_PASSWORD, DJANGO_EMAIL_USE_TLS, and DEFAULT_FROM_EMAIL.
