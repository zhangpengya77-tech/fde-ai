DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional alternate SQLite path; default is db.sqlite3 beside manage.py.
DJANGO_DB_NAME=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Gmail SMTP example (use a Google App Password, never your normal account password):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-account@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-16-character-app-password
# DJANGO_EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=FDE-AI <your-account@gmail.com>
