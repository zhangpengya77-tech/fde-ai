<RCC>
    <!-- FDE-QGC V1.0：覆寫官方 QML（FdeOverrideInterceptor 會把 qrc:/qml/... 導向 qrc:/Custom/qml/...） -->
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/MainWindow.qml">qml/MainWindow.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewCustomLayer.qml">qml/FlyViewCustomLayer.qml</file>
        <!-- V2-3：系統設定左側清單加入「仿真器」「編隊飛行」（官方項目不變） -->
        <file alias="QGroundControl/AppSettings/SettingsPagesModel.qml">qml/SettingsPagesModel.qml</file>
    </qresource>
    <!-- 台灣正體翻譯（由官方 zh_CN 以 OpenCC s2twp 轉換；tools\claude\make_zh_tw_ts.py） -->
    <qresource prefix="/fde/i18n">
        <file alias="fde_qgc_zh_TW.qm">i18n/fde_qgc_zh_TW.qm</file>
    </qresource>
    <!-- 讓 QGC 啟動時（設定檔載入前）就用 FDE 繁中翻譯：
         Windows 台灣中文環境的語系清單第一個是 zh-Hant-TW，QGC 會先找 qgc_*_zh_Hant_TW.qm，
         官方沒有這個檔名，所以不會和官方（空白的）zh_TW 檔衝突。介面字串＋設定頁 JSON 字串各一份。 -->
    <qresource prefix="/i18n">
        <file alias="qgc_source_zh_Hant_TW.qm">i18n/fde_qgc_zh_TW.qm</file>
        <file alias="qgc_json_zh_Hant_TW.qm">i18n/fde_json_zh_TW.qm</file>
        <!-- 設定頁語言選「中文 (Chinese)」時 QGC 會先找 zh_Hans_CN：FDE 為台灣用，也改用台灣正體翻譯 -->
        <file alias="qgc_source_zh_Hans_CN.qm">i18n/fde_qgc_zh_TW.qm</file>
        <file alias="qgc_json_zh_Hans_CN.qm">i18n/fde_json_zh_TW.qm</file>
    </qresource>
    <!-- 品牌：工具列左上角標誌 -->
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/FdeLogoFull.svg</file>
    </qresource>
</RCC>
